{
  "$defs": {
    "EvidenceFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "EvidenceFile",
      "type": "object"
    },
    "ResidencyComponentPlacement": {
      "additionalProperties": false,
      "properties": {
        "baseline_strategy": {
          "enum": [
            "resident",
            "component_cpu_offload",
            "layerwise_offload",
            "partial_dit_resident",
            "fsdp",
            "compile_transient_offload"
          ],
          "title": "Baseline Strategy",
          "type": "string"
        },
        "candidate_strategy": {
          "enum": [
            "resident",
            "component_cpu_offload",
            "layerwise_offload",
            "partial_dit_resident",
            "fsdp",
            "compile_transient_offload"
          ],
          "title": "Candidate Strategy",
          "type": "string"
        },
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "footprint_mib": {
          "exclusiveMinimum": 0.0,
          "title": "Footprint Mib",
          "type": "number"
        },
        "prefetch_depth": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefetch Depth"
        },
        "resident_layers": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resident Layers"
        },
        "total_layers": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Layers"
        }
      },
      "required": [
        "component",
        "baseline_strategy",
        "candidate_strategy",
        "footprint_mib"
      ],
      "title": "ResidencyComponentPlacement",
      "type": "object"
    },
    "ResidencyConflictChecks": {
      "additionalProperties": false,
      "properties": {
        "cache_dit_compatible": {
          "const": true,
          "title": "Cache Dit Compatible"
        },
        "explicit_policy_declared": {
          "const": true,
          "title": "Explicit Policy Declared"
        },
        "fsdp_compatible": {
          "const": true,
          "title": "Fsdp Compatible"
        },
        "steady_state_restored": {
          "const": true,
          "title": "Steady State Restored"
        },
        "unsupported_components_absent": {
          "const": true,
          "title": "Unsupported Components Absent"
        }
      },
      "required": [
        "explicit_policy_declared",
        "fsdp_compatible",
        "cache_dit_compatible",
        "steady_state_restored",
        "unsupported_components_absent"
      ],
      "title": "ResidencyConflictChecks",
      "type": "object"
    },
    "ResidencyMemorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "gpu_uuid": {
          "minLength": 1,
          "title": "Gpu Uuid",
          "type": "string"
        },
        "min_free_before_mib": {
          "minimum": 0.0,
          "title": "Min Free Before Mib",
          "type": "number"
        },
        "peak_reserved_mib": {
          "minimum": 0.0,
          "title": "Peak Reserved Mib",
          "type": "number"
        },
        "safety_margin_mib": {
          "exclusiveMinimum": 0.0,
          "title": "Safety Margin Mib",
          "type": "number"
        },
        "total_mib": {
          "exclusiveMinimum": 0.0,
          "title": "Total Mib",
          "type": "number"
        }
      },
      "required": [
        "gpu_uuid",
        "total_mib",
        "min_free_before_mib",
        "peak_reserved_mib",
        "safety_margin_mib"
      ],
      "title": "ResidencyMemorySnapshot",
      "type": "object"
    },
    "ResidencyTransferMeasurement": {
      "additionalProperties": false,
      "properties": {
        "h2d_copy_count": {
          "minimum": 0,
          "title": "H2D Copy Count",
          "type": "integer"
        },
        "h2d_total_ms": {
          "minimum": 0.0,
          "title": "H2D Total Ms",
          "type": "number"
        }
      },
      "required": [
        "h2d_copy_count",
        "h2d_total_ms"
      ],
      "title": "ResidencyTransferMeasurement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_memory": {
      "items": {
        "$ref": "#/$defs/ResidencyMemorySnapshot"
      },
      "minItems": 1,
      "title": "Baseline Memory",
      "type": "array"
    },
    "baseline_transfers": {
      "$ref": "#/$defs/ResidencyTransferMeasurement"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_memory": {
      "items": {
        "$ref": "#/$defs/ResidencyMemorySnapshot"
      },
      "minItems": 1,
      "title": "Candidate Memory",
      "type": "array"
    },
    "candidate_transfers": {
      "$ref": "#/$defs/ResidencyTransferMeasurement"
    },
    "compile_strategy": {
      "minLength": 1,
      "title": "Compile Strategy",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ResidencyComponentPlacement"
      },
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "conflicts": {
      "$ref": "#/$defs/ResidencyConflictChecks"
    },
    "coverage_id": {
      "minLength": 1,
      "title": "Coverage Id",
      "type": "string"
    },
    "engagement_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "minProperties": 1,
      "title": "Engagement Counts",
      "type": "object"
    },
    "equivalence_artifact": {
      "$ref": "#/$defs/EvidenceFile"
    },
    "gpu_uuids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Gpu Uuids",
      "type": "array"
    },
    "performance_artifact": {
      "$ref": "#/$defs/EvidenceFile"
    },
    "profile_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Digest Sha256",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version"
    },
    "steady_state_strategy": {
      "minLength": 1,
      "title": "Steady State Strategy",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "run_id",
    "coverage_id",
    "profile_digest_sha256",
    "gpu_uuids",
    "baseline_memory",
    "candidate_memory",
    "baseline_transfers",
    "candidate_transfers",
    "components",
    "compile_strategy",
    "steady_state_strategy",
    "conflicts",
    "engagement_counts",
    "performance_artifact",
    "equivalence_artifact"
  ],
  "title": "ResidencyEvidence",
  "type": "object"
}

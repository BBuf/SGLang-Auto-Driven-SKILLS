{
  "$defs": {
    "CoverageItem": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "format": "path",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scientific_round_ids": {
          "items": {
            "type": "string"
          },
          "title": "Scientific Round Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "measured",
            "inapplicable",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "title": "CoverageItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "classification": {
      "enum": [
        "unsupported",
        "no_gain",
        "blocked",
        "budget_exhausted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageItem"
      },
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "profile_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Digest Sha256",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version"
    },
    "technique": {
      "minLength": 1,
      "title": "Technique",
      "type": "string"
    }
  },
  "required": [
    "technique",
    "classification",
    "reason",
    "coverage",
    "profile_digest_sha256"
  ],
  "title": "TechniqueDisposition",
  "type": "object"
}

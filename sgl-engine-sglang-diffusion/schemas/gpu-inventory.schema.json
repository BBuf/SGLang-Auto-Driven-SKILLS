{
  "$defs": {
    "GpuInventoryDevice": {
      "additionalProperties": false,
      "properties": {
        "physical_index": {
          "minimum": 0,
          "title": "Physical Index",
          "type": "integer"
        },
        "total_mib": {
          "exclusiveMinimum": 0.0,
          "title": "Total Mib",
          "type": "number"
        },
        "uuid": {
          "minLength": 1,
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "physical_index",
        "uuid",
        "total_mib"
      ],
      "title": "GpuInventoryDevice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Controller-owned identity of the GPUs selected by the frozen baseline.",
  "properties": {
    "baseline_command_template_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Command Template Sha256"
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/GpuInventoryDevice"
      },
      "minItems": 1,
      "title": "Devices",
      "type": "array"
    },
    "gpu_count": {
      "exclusiveMinimum": 0,
      "title": "Gpu Count",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version"
    },
    "visibility_source": {
      "enum": [
        "frozen_command_env",
        "controller_env",
        "default_order"
      ],
      "title": "Visibility Source",
      "type": "string"
    },
    "visible_device_tokens": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visible Device Tokens"
    }
  },
  "required": [
    "gpu_count",
    "visibility_source",
    "devices"
  ],
  "title": "GpuInventory",
  "type": "object"
}

{
  "$defs": {
    "AgentSpec": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "command"
      ],
      "title": "AgentSpec",
      "type": "object"
    },
    "BaselineCommandRequest": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argv"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "cwd": {
          "format": "path",
          "title": "Cwd",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "timing_scope": {
          "default": "load_excluded_end_to_end",
          "title": "Timing Scope",
          "type": "string"
        }
      },
      "required": [
        "cwd"
      ],
      "title": "BaselineCommandRequest",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "fastvideo_ref": {
          "default": "main",
          "title": "Fastvideo Ref",
          "type": "string"
        },
        "fastvideo_repo": {
          "default": "https://github.com/hao-ai-lab/FastVideo.git",
          "title": "Fastvideo Repo",
          "type": "string"
        },
        "kda_pilot_ref": {
          "default": "main",
          "title": "Kda Pilot Ref",
          "type": "string"
        },
        "kda_pilot_repo": {
          "default": "https://github.com/BBuf/KDA-Pilot.git",
          "title": "Kda Pilot Repo",
          "type": "string"
        },
        "sglang_ref": {
          "default": "main",
          "title": "Sglang Ref",
          "type": "string"
        },
        "sglang_repo": {
          "title": "Sglang Repo",
          "type": "string"
        },
        "sol_engine_ref": {
          "default": "cee25847afdd34bc656abcca126262200b088dc8",
          "title": "Sol Engine Ref",
          "type": "string"
        },
        "sol_engine_repo": {
          "default": "https://github.com/NVlabs/Sana.git",
          "title": "Sol Engine Repo",
          "type": "string"
        }
      },
      "required": [
        "sglang_repo"
      ],
      "title": "SourceSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentSpec"
    },
    "allow_quality_gated": {
      "default": true,
      "title": "Allow Quality Gated",
      "type": "boolean"
    },
    "baseline": {
      "$ref": "#/$defs/BaselineCommandRequest"
    },
    "gpu_count": {
      "default": 1,
      "minimum": 1,
      "title": "Gpu Count",
      "type": "integer"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "machine": {
      "minLength": 1,
      "title": "Machine",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "run_root": {
      "default": "runs/sgl-engine-sglang-diffusion",
      "format": "path",
      "title": "Run Root",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version"
    },
    "sglang_checkout": {
      "format": "path",
      "title": "Sglang Checkout",
      "type": "string"
    },
    "sglang_ref": {
      "default": "main",
      "title": "Sglang Ref",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target_speedup": {
      "exclusiveMinimum": 1.0,
      "title": "Target Speedup",
      "type": "number"
    },
    "token_budget": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Budget"
    }
  },
  "required": [
    "machine",
    "model",
    "sglang_checkout",
    "target_speedup",
    "baseline"
  ],
  "title": "LaunchRequest",
  "type": "object"
}

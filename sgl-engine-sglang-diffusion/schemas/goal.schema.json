{
  "$defs": {
    "GoalTarget": {
      "additionalProperties": false,
      "properties": {
        "allow_quality_gated": {
          "title": "Allow Quality Gated",
          "type": "boolean"
        },
        "target_speedup": {
          "exclusiveMinimum": 1.0,
          "title": "Target Speedup",
          "type": "number"
        }
      },
      "required": [
        "target_speedup",
        "allow_quality_gated"
      ],
      "title": "GoalTarget",
      "type": "object"
    },
    "HardwareSpec": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "minLength": 1,
          "title": "Environment",
          "type": "string"
        },
        "gpu_count": {
          "minimum": 1,
          "title": "Gpu Count",
          "type": "integer"
        }
      },
      "required": [
        "environment",
        "gpu_count"
      ],
      "title": "HardwareSpec",
      "type": "object"
    },
    "ModelSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ModelSpec",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "fastvideo_ref": {
          "default": "main",
          "title": "Fastvideo Ref",
          "type": "string"
        },
        "fastvideo_repo": {
          "default": "https://github.com/hao-ai-lab/FastVideo.git",
          "title": "Fastvideo Repo",
          "type": "string"
        },
        "kda_pilot_ref": {
          "default": "main",
          "title": "Kda Pilot Ref",
          "type": "string"
        },
        "kda_pilot_repo": {
          "default": "https://github.com/BBuf/KDA-Pilot.git",
          "title": "Kda Pilot Repo",
          "type": "string"
        },
        "sglang_ref": {
          "default": "main",
          "title": "Sglang Ref",
          "type": "string"
        },
        "sglang_repo": {
          "title": "Sglang Repo",
          "type": "string"
        }
      },
      "required": [
        "sglang_repo"
      ],
      "title": "SourceSpec",
      "type": "object"
    },
    "WorkloadSpec": {
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "fps": {
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "integer"
        },
        "frames": {
          "exclusiveMinimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "guidance": {
          "minimum": 0.0,
          "title": "Guidance",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "prompt_count": {
          "minimum": 5,
          "title": "Prompt Count",
          "type": "integer"
        },
        "prompts": {
          "format": "path",
          "title": "Prompts",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "steps": {
          "exclusiveMinimum": 0,
          "title": "Steps",
          "type": "integer"
        },
        "timing_scope": {
          "title": "Timing Scope",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "prompts",
        "prompt_count",
        "seed",
        "height",
        "width",
        "frames",
        "fps",
        "steps",
        "guidance",
        "dtype",
        "timing_scope"
      ],
      "title": "WorkloadSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution_mode": {
      "const": "interactive_single_agent",
      "default": "interactive_single_agent",
      "title": "Execution Mode"
    },
    "goal": {
      "$ref": "#/$defs/GoalTarget"
    },
    "hardware": {
      "$ref": "#/$defs/HardwareSpec"
    },
    "model": {
      "$ref": "#/$defs/ModelSpec"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version"
    },
    "source": {
      "$ref": "#/$defs/SourceSpec"
    },
    "workload": {
      "$ref": "#/$defs/WorkloadSpec"
    }
  },
  "required": [
    "model",
    "hardware",
    "workload",
    "goal",
    "source"
  ],
  "title": "CampaignGoal",
  "type": "object"
}
